local cooldownEnds = {}

local function isOnCooldown(abilityName)
	local endTime = cooldownEnds[abilityName]
	return endTime ~= nil and endTime > os.clock()
end

local abilityFunctions = {
	Shield = playShield,
	MagicHands = playMagicHands,
	Blast = playBlast,
	Whip = playWhip,
	Astral = playAstral,
	Illusion = playIllusion,
	Ultimate = playUltimate,
}

handleAbilityInput = function(abilityName)
	if not character or not humanoid or humanoid.Health <= 0 then
		return
	end

	if freezeDepth > 0 then
		return
	end

	if abilityName == "Portal" then
		if isOnCooldown("Portal") then
			showMessage("⏳ Portal ainda em recarga", 2)
			return
		end
		startPortalSelection()
		return
	end

	if isOnCooldown(abilityName) then
		showMessage("⏳ Em recarga", 1.2)
		return
	end

	local cfg = ABILITY_CFG[abilityName]
	cooldownEnds[abilityName] = os.clock() + cfg.Cooldown
	setCooldown(abilityName, cfg.Cooldown)

	local fn = abilityFunctions[abilityName]
	if fn then
		fn()
	end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end
	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end
	for abilityName, keyCode in pairs(KEYBINDS) do
		if input.KeyCode == keyCode then
			handleAbilityInput(abilityName)
			return
		end
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if isSelectingPortal and input.UserInputType == Enum.UserInputType.MouseMovement then
		mouseDeltaAccum += Vector2.new(input.Delta.X, input.Delta.Y)
	end
end)

