local Effects = {}

local spinning = {} -- [part] = graus/seg (rotação própria, parte parada no mundo)
local attached = {} -- [part] = { Limb, Offset, SpinSpeed, Angle } (acompanha um membro via script)

RunService.Heartbeat:Connect(function(dt)
	for part, speed in pairs(spinning) do
		if part.Parent then
			part.CFrame = part.CFrame * CFrame.Angles(0, math.rad(speed * dt), 0)
		else
			spinning[part] = nil
		end
	end
	for part, info in pairs(attached) do
		if part.Parent and info.Limb.Parent then
			if info.SpinSpeed ~= 0 then
				info.Angle = (info.Angle + info.SpinSpeed * dt) % 360
				part.CFrame = info.Limb.CFrame * info.Offset * CFrame.Angles(0, math.rad(info.Angle), 0)
			else
				part.CFrame = info.Limb.CFrame * info.Offset
			end
		else
			attached[part] = nil
		end
	end
end)

function Effects.RegisterSpin(part, degreesPerSecond)
	spinning[part] = degreesPerSecond
end

function Effects.UnregisterSpin(part)
	spinning[part] = nil
end

-- Part padrão (Block) fino + Decal, evitando a ambiguidade das faces
-- "redondas" do PartType.Cylinder (que ficam em Left/Right no Roblox).
-- vertical=false -> disco deitado (Top/Bottom). vertical=true -> disco
-- em pé, decal em Front/Back (Front = LookVector do CFrame recebido).
function Effects.CreateCircle(cframe, diameter, color, vertical, textureId)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Transparency = 1
	part.CFrame = cframe

	local faces
	if vertical then
		part.Size = Vector3.new(diameter, diameter, 0.2)
		faces = { Enum.NormalId.Front, Enum.NormalId.Back }
	else
		part.Size = Vector3.new(diameter, 0.2, diameter)
		faces = { Enum.NormalId.Top, Enum.NormalId.Bottom }
	end

	local tex = textureId or ASSET_IDS.MagicCircle
	for _, face in ipairs(faces) do
		local decal = Instance.new("Decal")
		decal.Texture = tex
		decal.Face = face
		decal.Transparency = 1
		decal.Parent = part
	end

	part.Parent = workspace
	return part
end

-- O Part em si NUNCA fica visível (Transparency sempre 1) — só o Decal
-- é animado. É isso que evita o "quadrado" atrás da textura mágica.
function Effects.FadeIn(part, duration, _unusedTargetTransparency)
	part.Transparency = 1
	for _, child in ipairs(part:GetChildren()) do
		if child:IsA("Decal") then
			child.Transparency = 1
			TweenService:Create(child, TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
				Transparency = 0,
			}):Play()
		end
	end
end

function Effects.FadeOutAndDestroy(part, duration)
	if not part or not part.Parent then
		return
	end
	Effects.UnregisterSpin(part)
	Effects.Detach(part)
	for _, child in ipairs(part:GetChildren()) do
		if child:IsA("Decal") then
			TweenService:Create(child, TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {
				Transparency = 1,
			}):Play()
		end
	end
	Debris:AddItem(part, duration + 0.1)
end

function Effects.EmitBurst(attachment, textureId, count, color)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = textureId or ASSET_IDS.MagicCircle
	emitter.Color = ColorSequence.new(color)
	emitter.Lifetime = NumberRange.new(0.4, 0.8)
	emitter.Speed = NumberRange.new(4, 10)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-90, 90)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Rate = 0
	emitter.Parent = attachment
	emitter:Emit(count)
	Debris:AddItem(emitter, 1.5)
end

function Effects.CreateImpactBolt(from, to, color, onArrive)
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.new(1, 1, 1)
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CFrame = CFrame.new(from)
	part.Parent = workspace

	local distance = (to - from).Magnitude
	local duration = math.clamp(distance / 140, 0.05, 0.4)

	local tween = TweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		CFrame = CFrame.new(to),
	})
	tween:Play()
	tween.Completed:Connect(function()
		if onArrive then
			onArrive()
		end
		part:Destroy()
	end)
	Debris:AddItem(part, duration + 1)
end

function Effects.CreateImpactBurst(position, color, textureId)
	local attachPart = Instance.new("Part")
	attachPart.Size = Vector3.new(0.2, 0.2, 0.2)
	attachPart.Transparency = 1
	attachPart.Anchored = true
	attachPart.CanCollide = false
	attachPart.CanTouch = false
	attachPart.CanQuery = false
	attachPart.CFrame = CFrame.new(position)
	attachPart.Parent = workspace

	local attachment = Instance.new("Attachment", attachPart)
	Effects.EmitBurst(attachment, textureId, 14, color)
	Debris:AddItem(attachPart, 2)
end

function Effects.GetHand(character, isRight)
	if isRight then
		return character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	else
		return character:FindFirstChild("LeftHand") or character:FindFirstChild("Left Arm")
	end
end

-- Substitui a solda física (WeldConstraint) por acompanhamento via
-- script: o Part fica Anchored = true (não participa da física) e o
-- loop de Heartbeat acima só COPIA o CFrame do membro + um offset.
-- Isso torna IMPOSSÍVEL esse efeito mover, girar ou empurrar o
-- personagem — é uma via de mão única (membro -> efeito, nunca o
-- contrário). spinDegPerSec é opcional (0 = só acompanha, sem girar).
function Effects.AttachTo(part, limb, offsetCFrame, spinDegPerSec)
	part.Anchored = true
	local offset = offsetCFrame or CFrame.new()
	attached[part] = { Limb = limb, Offset = offset, SpinSpeed = spinDegPerSec or 0, Angle = 0 }
	part.CFrame = limb.CFrame * offset
end

function Effects.Detach(part)
	attached[part] = nil
end

