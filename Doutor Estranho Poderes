----------------------------------------------------------------
-- 6) PORTAL: câmera de seleção + criação + travessia
----------------------------------------------------------------
local isSelectingPortal = false
local flyConnection = nil
local flyPosition, flyYaw, flyPitch = Vector3.new(), 0, 0
local candidatePosition = nil
local reticlePart = nil
local reticleBeam = nil
local mouseDeltaAccum = Vector2.new(0, 0)
local originalCameraType = Enum.CameraType.Custom
local activePortalOrigin, activePortalDestination = nil, nil
local activePortalDetection = nil

-- O portal é composto por dois objetos, e NENHUM DOS DOIS gira:
--   Main -> o disco grande com a textura de Portal. Orientação
--           calculada UMA VEZ na criação e nunca mais alterada.
--   Ring -> um anel decorativo menor (textura Magic Circle). Não gira;
--           só pulsa (brilha/esmaece) bem devagar, um detalhe pequeno
--           e sutil, exatamente como pedido.
local function createPortalVisual(cframe, color)
	local main = Effects.CreateCircle(cframe, PORTAL_CFG.PortalHeight, color, true, ASSET_IDS.Portal)
	Effects.FadeIn(main, 0.4)
	-- NUNCA chamar Effects.RegisterSpin/AttachTo com spin no "main":
	-- ele precisa ficar 100% parado, sempre olhando na mesma direção.

	local ring = Effects.CreateCircle(cframe, PORTAL_CFG.PortalHeight * 0.45, color, true, ASSET_IDS.MagicCircle)
	Effects.FadeIn(ring, 0.4)
	-- pulso sutil de brilho — SEM nenhuma rotação
	for _, decal in ipairs(ring:GetChildren()) do
		if decal:IsA("Decal") then
			TweenService:Create(decal, TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
				Transparency = 0.5,
			}):Play()
		end
	end

	return { Main = main, Ring = ring }
end

local function fadePortalVisual(visual, duration)
	if not visual then
		return
	end
	if visual.Main then
		Effects.FadeOutAndDestroy(visual.Main, duration)
	end
	if visual.Ring then
		Effects.FadeOutAndDestroy(visual.Ring, duration)
	end
end

local function updateReticle(position, valid)
	local color = valid and Color3.fromRGB(120, 230, 140) or Color3.fromRGB(255, 90, 90)
	if not reticlePart then
		reticlePart = Effects.CreateCircle(CFrame.new(position), 8, color, false, ASSET_IDS.MagicCircle)
		Effects.RegisterSpin(reticlePart, 45)
	else
		reticlePart.CFrame = CFrame.new(position)
		reticlePart.Color = color
	end

	if not reticleBeam then
		reticleBeam = Instance.new("Part")
		reticleBeam.Anchored = true
		reticleBeam.CanCollide = false
		reticleBeam.CanTouch = false
		reticleBeam.CanQuery = false
		reticleBeam.Material = Enum.Material.Neon
		reticleBeam.Size = Vector3.new(0.4, 20, 0.4)
		reticleBeam.Transparency = 0.35
		reticleBeam.Parent = workspace
	end
	reticleBeam.Color = color
	reticleBeam.CFrame = CFrame.new(position + Vector3.new(0, 10, 0))
end

local function hideReticle()
	if reticlePart then
		Effects.UnregisterSpin(reticlePart)
		reticlePart:Destroy()
		reticlePart = nil
	end
	if reticleBeam then
		reticleBeam:Destroy()
		reticleBeam = nil
	end
end

local function closePortalVisuals()
	if activePortalOrigin then
		fadePortalVisual(activePortalOrigin, 0.6)
		activePortalOrigin = nil
	end
	if activePortalDestination then
		fadePortalVisual(activePortalDestination, 0.6)
		activePortalDestination = nil
	end
	if activePortalDetection then
		activePortalDetection:Destroy()
		activePortalDetection = nil
	end
end

local function exitFlyMode(restoreCamera)
	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end
	if isSelectingPortal then
		unfreezeCharacter()
	end
	isSelectingPortal = false
	candidatePosition = nil
	hideReticle()
	portalUI.Visible = false
	if restoreCamera then
		camera.CameraType = originalCameraType
	end
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = true
end

local function updateFlyCamera(dt)
	if not rootPart then
		return
	end

	local lookDelta = mouseDeltaAccum
	mouseDeltaAccum = Vector2.new(0, 0)
	if isTouch then
		lookDelta += lookDeltaAccum
		lookDeltaAccum = Vector2.new(0, 0)
	end

	local sensitivity = PORTAL_CFG.FlyCamLookSensitivity
	flyYaw = flyYaw - (lookDelta.X * sensitivity * 0.1)
	flyPitch = math.clamp(flyPitch - (lookDelta.Y * sensitivity * 0.1), -80, 80)

	local rotation = CFrame.Angles(0, math.rad(flyYaw), 0) * CFrame.Angles(math.rad(flyPitch), 0, 0)

	local moveVector = Vector3.new(0, 0, 0)
	if isTouch then
		moveVector += Vector3.new(joystickVector.X, 0, joystickVector.Y)
	end
	if isKeyboard then
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVector += Vector3.new(0, 0, -1) end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVector += Vector3.new(0, 0, 1) end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVector += Vector3.new(-1, 0, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVector += Vector3.new(1, 0, 0) end
	end
	if moveVector.Magnitude > 1 then
		moveVector = moveVector.Unit
	end

	local speed = PORTAL_CFG.FlyCamSpeed
	if isKeyboard and UserInputService:IsKeyDown(FLYCAM_KEYS.Boost) then
		speed = PORTAL_CFG.FlyCamBoostSpeed
	end

	local vertical = 0
	if upHeld or (isKeyboard and UserInputService:IsKeyDown(FLYCAM_KEYS.Up)) then
		vertical += 1
	end
	if downHeld or (isKeyboard and UserInputService:IsKeyDown(FLYCAM_KEYS.Down)) then
		vertical -= 1
	end

	local worldMove = rotation:VectorToWorldSpace(moveVector) * speed * dt
	worldMove += Vector3.new(0, vertical * PORTAL_CFG.FlyCamVerticalSpeed * dt, 0)
	flyPosition += worldMove

	camera.CFrame = CFrame.new(flyPosition) * rotation

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }

	local result = workspace:Raycast(flyPosition, Vector3.new(0, -2000, 0), params)
	if result then
		local distance = (result.Position - rootPart.Position).Magnitude
		local valid = distance <= PORTAL_CFG.MaxDistance and result.Normal.Y >= PORTAL_CFG.MinWalkableNormalY
		candidatePosition = valid and result.Position or nil
		updateReticle(result.Position, valid)
		if valid then
			statusLabel.Text = string.format("✅ Destino válido (%.0f studs)", distance)
			statusLabel.TextColor3 = Color3.fromRGB(120, 230, 140)
		elseif distance > PORTAL_CFG.MaxDistance then
			statusLabel.Text = "❌ Muito longe"
			statusLabel.TextColor3 = THEME.Danger
		else
			statusLabel.Text = "❌ Superfície inválida"
			statusLabel.TextColor3 = THEME.Danger
		end
	else
		candidatePosition = nil
		hideReticle()
		statusLabel.Text = "❌ Nenhum chão encontrado"
		statusLabel.TextColor3 = THEME.Danger
	end
end

local function onPortalTouched(hit)
	if not activePortalDetection or not activePortalOrigin then
		return
	end
	if not character or not hit:IsDescendantOf(character) then
		return
	end

	local originCFrame = activePortalOrigin.Main.CFrame
	local destinationHit = activePortalDetection:GetAttribute("DestX") and Vector3.new(
		activePortalDetection:GetAttribute("DestX"),
		activePortalDetection:GetAttribute("DestY"),
		activePortalDetection:GetAttribute("DestZ")
	) or rootPart.Position

	activePortalDetection:Destroy()
	activePortalDetection = nil

	local hipHeight = humanoid.HipHeight or 2
	local exitPosition = destinationHit + Vector3.new(0, hipHeight + rootPart.Size.Y / 2 + 0.2, 0)
		+ originCFrame.LookVector * PORTAL_CFG.OriginOffset * 0.5
	local destinationCFrame = CFrame.lookAt(exitPosition, exitPosition + originCFrame.LookVector)

	character:PivotTo(destinationCFrame)

	if activePortalOrigin then
		fadePortalVisual(activePortalOrigin, 0.4)
		activePortalOrigin = nil
	end

	local visual = createPortalVisual(destinationCFrame, Color3.fromRGB(255, 180, 60))
	activePortalDestination = visual
	Effects.CreateImpactBurst(destinationCFrame.Position, Color3.fromRGB(255, 180, 60), ASSET_IDS.MagicCircle)

	task.delay(PORTAL_CFG.ExitVisualLifetime, function()
		if activePortalDestination == visual then
			fadePortalVisual(visual, 0.6)
			activePortalDestination = nil
		end
	end)
end

local function confirmPortal()
	if not candidatePosition then
		showMessage("Escolha um destino válido primeiro", 2)
		return
	end

	-- validação local (sem servidor): distância, chão e obstrução
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }

	local rayOrigin = candidatePosition + Vector3.new(0, PORTAL_CFG.GroundCheckTolerance, 0)
	local result = workspace:Raycast(rayOrigin, Vector3.new(0, -(PORTAL_CFG.GroundCheckTolerance * 2), 0), params)
	if not result then
		showMessage("❌ Local inválido", 2)
		return
	end

	local overlapParams = OverlapParams.new()
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude
	overlapParams.FilterDescendantsInstances = { character, result.Instance }
	local checkCenter = result.Position + Vector3.new(0, PORTAL_CFG.ObstructionCheckSize.Y / 2 + 0.5, 0)
	local overlapping = workspace:GetPartBoundsInBox(CFrame.new(checkCenter), PORTAL_CFG.ObstructionCheckSize, overlapParams)
	for _, part in ipairs(overlapping) do
		if part.CanCollide then
			showMessage("🚫 Local obstruído", 2)
			return
		end
	end

	setCooldown("Portal", ABILITY_CFG.Portal.Cooldown)
	exitFlyMode(true)

	local facing = rootPart.CFrame.LookVector
	local originPos = rootPart.Position + facing * PORTAL_CFG.OriginOffset + Vector3.new(0, PORTAL_CFG.OriginHeight - rootPart.Size.Y / 2, 0)
	local originCFrame = CFrame.lookAt(originPos, originPos + facing)

	local part = createPortalVisual(originCFrame, Color3.fromRGB(255, 140, 40))
	activePortalOrigin = part

	local detectionPart = Instance.new("Part")
	detectionPart.Name = "PortalDetection"
	detectionPart.Size = PORTAL_CFG.EntryDetectionSize
	detectionPart.CFrame = originCFrame
	detectionPart.Anchored = true
	detectionPart.CanCollide = false
	detectionPart.CanTouch = true
	detectionPart.CanQuery = false
	detectionPart.Transparency = 1
	detectionPart:SetAttribute("DestX", result.Position.X)
	detectionPart:SetAttribute("DestY", result.Position.Y)
	detectionPart:SetAttribute("DestZ", result.Position.Z)
	detectionPart.Parent = workspace
	activePortalDetection = detectionPart

	local connection
	connection = detectionPart.Touched:Connect(function(hit)
		onPortalTouched(hit)
	end)

	task.delay(PORTAL_CFG.PortalLifetime, function()
		if connection then
			connection:Disconnect()
		end
		if activePortalDetection == detectionPart then
			detectionPart:Destroy()
			activePortalDetection = nil
			closePortalVisuals()
		end
	end)
end

local function cancelPortal()
	exitFlyMode(true)
end

confirmBtn.Activated:Connect(confirmPortal)
cancelBtn.Activated:Connect(cancelPortal)

local function startPortalSelection()
	if isSelectingPortal or not rootPart or humanoid.Health <= 0 then
		return
	end
	isSelectingPortal = true
	freezeCharacter()

	originalCameraType = camera.CameraType
	flyPosition = camera.CFrame.Position
	local rx, ry = camera.CFrame:ToOrientation()
	flyPitch = math.deg(rx)
	flyYaw = math.deg(ry)

	camera.CameraType = Enum.CameraType.Scriptable
	portalUI.Visible = true
	joystickVector = Vector2.new(0, 0)
	lookDeltaAccum = Vector2.new(0, 0)

	if isKeyboard then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		UserInputService.MouseIconEnabled = false
	end

	flyConnection = RunService.RenderStepped:Connect(updateFlyCamera)
end

