local character = player.Character
local humanoid, rootPart
local savedWalkSpeed, savedJumpPower, savedJumpHeight = 16, 50, 7.2

-- Controle oficial de movimento do jogador (PlayerModule). Usado para
-- BLOQUEAR de verdade andar/correr/pular/virar durante a seleção do
-- Portal e as habilidades que "param" o personagem — sem isso, os
-- controles padrão do Roblox continuam lendo WASD ao mesmo tempo que
-- o nosso script, e é isso que fazia o personagem andar/girar sozinho.
local playerControls = nil
do
	local ok, result = pcall(function()
		local playerScripts = player:WaitForChild("PlayerScripts", 10)
		local playerModule = require(playerScripts:WaitForChild("PlayerModule", 10))
		return playerModule:GetControls()
	end)
	if ok then
		playerControls = result
	end
end

local freezeDepth = 0

local function freezeCharacter()
	freezeDepth += 1
	if freezeDepth > 1 then
		return
	end
	if playerControls then
		pcall(function() playerControls:Disable() end)
	end
	if humanoid then
		humanoid.WalkSpeed = 0
		humanoid.JumpPower = 0
		humanoid.JumpHeight = 0
		humanoid.AutoRotate = false
	end
end

local function unfreezeCharacter()
	freezeDepth = math.max(0, freezeDepth - 1)
	if freezeDepth > 0 then
		return
	end
	if playerControls then
		pcall(function() playerControls:Enable() end)
	end
	if humanoid and humanoid.Parent then
		humanoid.WalkSpeed = savedWalkSpeed
		humanoid.JumpPower = savedJumpPower
		humanoid.JumpHeight = savedJumpHeight
		humanoid.AutoRotate = true
	end
end

local function bindCharacter(char)
	character = char
	humanoid = char:WaitForChild("Humanoid")
	rootPart = char:WaitForChild("HumanoidRootPart")
	savedWalkSpeed = humanoid.WalkSpeed
	savedJumpPower = humanoid.JumpPower
	savedJumpHeight = humanoid.JumpHeight
	-- personagem novo (respawn): garante que nada fique travado de uma
	-- vida anterior
	freezeDepth = 0
	if playerControls then
		pcall(function() playerControls:Enable() end)
	end
end

if character then
	bindCharacter(character)
end
player.CharacterAdded:Connect(bindCharacter)

