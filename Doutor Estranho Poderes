-- 7) MIRA (Rajada / Chicote)
----------------------------------------------------------------
local function getAimTargetPosition(range)
	local origin = camera.CFrame.Position
	local direction = camera.CFrame.LookVector * range
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	local result = workspace:Raycast(origin, direction, params)
	if result then
		return result.Position
	end
	return origin + direction
end

local function getPlayersInRadius(position, radius)
	local results = {}
	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= player and otherPlayer.Character then
			local otherHumanoid = otherPlayer.Character:FindFirstChildOfClass("Humanoid")
			local otherRoot = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
			if otherHumanoid and otherRoot and otherHumanoid.Health > 0 then
				if (otherRoot.Position - position).Magnitude <= radius then
					table.insert(results, { Humanoid = otherHumanoid, RootPart = otherRoot })
				end
			end
		end
	end
	return results
end

