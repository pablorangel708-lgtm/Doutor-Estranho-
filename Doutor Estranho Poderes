local shieldActive = false
local magicHandsActive = false
local activeHandCircles = nil

local function playShield()
	local cfg = ABILITY_CFG.Shield
	shieldActive = true

	local root = rootPart
	local part = Effects.CreateCircle(root.CFrame * CFrame.new(0, 0, -3), 6, Color3.fromRGB(120, 200, 255), true, ASSET_IDS.Shield)
	Effects.AttachTo(part, root, CFrame.new(0, 0, -3), 20)
	Effects.FadeIn(part, 0.3)

	task.delay(cfg.Duration, function()
		shieldActive = false
		Effects.FadeOutAndDestroy(part, 0.4)
	end)
end

local function playMagicHands()
	magicHandsActive = not magicHandsActive

	if not magicHandsActive then
		if activeHandCircles then
			if activeHandCircles.Left then Effects.FadeOutAndDestroy(activeHandCircles.Left, 0.25) end
			if activeHandCircles.Right then Effects.FadeOutAndDestroy(activeHandCircles.Right, 0.25) end
			activeHandCircles = nil
		end
		return
	end

	local leftHand = Effects.GetHand(character, false)
	local rightHand = Effects.GetHand(character, true)
	local entry = {}

	if leftHand then
		local circle = Effects.CreateCircle(leftHand.CFrame, 1.6, Color3.fromRGB(255, 170, 60), false, ASSET_IDS.MagicCircle)
		Effects.AttachTo(circle, leftHand, CFrame.new(0, -0.6, 0), 90)
		Effects.FadeIn(circle, 0.2)
		entry.Left = circle
	end
	if rightHand then
		local circle = Effects.CreateCircle(rightHand.CFrame, 1.6, Color3.fromRGB(255, 170, 60), false, ASSET_IDS.MagicCircle)
		Effects.AttachTo(circle, rightHand, CFrame.new(0, -0.6, 0), -90)
		Effects.FadeIn(circle, 0.2)
		entry.Right = circle
	end

	activeHandCircles = entry
end

local function playBlast()
	local cfg = ABILITY_CFG.Blast
	local aimPoint = getAimTargetPosition(cfg.Range)
	local direction = (aimPoint - rootPart.Position)
	if direction.Magnitude <= 0.01 then
		direction = rootPart.CFrame.LookVector
	end
	direction = direction.Unit

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }

	local origin = rootPart.Position + Vector3.new(0, 1, 0)
	local result = workspace:Raycast(origin, direction * cfg.Range, params)
	local hitPosition = origin + direction * cfg.Range

	if result then
		hitPosition = result.Position
		local hitCharacter = result.Instance:FindFirstAncestorOfClass("Model")
		local targetPlayer = hitCharacter and Players:GetPlayerFromCharacter(hitCharacter)
		if targetPlayer and targetPlayer ~= player then
			local targetHumanoid = hitCharacter:FindFirstChildOfClass("Humanoid")
			local targetRoot = hitCharacter:FindFirstChild("HumanoidRootPart")
			if targetHumanoid and targetRoot and targetHumanoid.Health > 0 then
				targetHumanoid:TakeDamage(cfg.Damage) -- best-effort (ver aviso no topo do arquivo)
				targetRoot.AssemblyLinearVelocity = targetRoot.AssemblyLinearVelocity
					+ Vector3.new(direction.X, 0.18, direction.Z) * cfg.KnockbackForce
			end
		end
	end

	Effects.CreateImpactBolt(origin, hitPosition, Color3.fromRGB(255, 150, 40), function()
		Effects.CreateImpactBurst(hitPosition, Color3.fromRGB(255, 150, 40), ASSET_IDS.MagicCircle)
	end)
end

-- Chicote, Astral e Ilusão estão temporariamente DESATIVADOS (a
-- pedido): por enquanto só congelam o personagem (mesmo sistema do
-- Portal) com um efeito visual pequeno. Cooldown e botão continuam
-- normalmente. Nenhum causa dano, cria clone ou move o personagem.
local FROZEN_PLACEHOLDER_DURATION = {
	Whip = 1.2,
	Astral = 3,
	Illusion = 1.2,
}
local FROZEN_PLACEHOLDER_COLOR = {
	Whip = Color3.fromRGB(255, 120, 60),
	Astral = Color3.fromRGB(180, 160, 255),
	Illusion = Color3.fromRGB(200, 160, 255),
}

local function playFrozenPlaceholder(abilityName)
	freezeCharacter()
	if rootPart then
		Effects.CreateImpactBurst(rootPart.Position, FROZEN_PLACEHOLDER_COLOR[abilityName], ASSET_IDS.MagicCircle)
	end
	task.delay(FROZEN_PLACEHOLDER_DURATION[abilityName], function()
		unfreezeCharacter()
	end)
end

local function playWhip()
	playFrozenPlaceholder("Whip")
end

local function playAstral()
	playFrozenPlaceholder("Astral")
end

local function playIllusion()
	playFrozenPlaceholder("Illusion")
end

local function playUltimate()
	local cfg = ABILITY_CFG.Ultimate
	local castPosition = rootPart.Position
	local base = CFrame.new(castPosition)

	for i = 1, 3 do
		local diameter = cfg.Radius * (0.4 + i * 0.25)
		local circle = Effects.CreateCircle(base * CFrame.new(0, 0.1 * i, 0), diameter, Color3.fromRGB(255, 150, 40), false, ASSET_IDS.MagicCircle)
		Effects.RegisterSpin(circle, i % 2 == 0 and 20 or -20)
		Effects.FadeIn(circle, cfg.PrepTime, 0.35)
		task.delay(cfg.PrepTime + 1.2, function()
			Effects.FadeOutAndDestroy(circle, 0.6)
		end)
	end

	task.delay(cfg.PrepTime, function()
		local targets = getPlayersInRadius(castPosition, cfg.Radius)
		for _, target in ipairs(targets) do
			target.Humanoid:TakeDamage(cfg.Damage) -- best-effort (ver aviso no topo do arquivo)
			local tWalk, tJump = target.Humanoid.WalkSpeed, target.Humanoid.JumpPower
			target.Humanoid.WalkSpeed = 0
			target.Humanoid.JumpPower = 0
			task.delay(cfg.ImmobilizeTime, function()
				if target.Humanoid.Parent and target.Humanoid.Health > 0 then
					target.Humanoid.WalkSpeed = tWalk
					target.Humanoid.JumpPower = tJump
				end
			end)
		end
		Effects.CreateImpactBurst(castPosition, Color3.fromRGB(255, 190, 90), ASSET_IDS.MagicCircle)
	end)
end

-- Escudo local: tenta "curar de volta" parte do dano recebido enquanto
-- ativo (aproximação client-side de redução de dano, já que não há
-- servidor validando quem pode alterar o Health de quem).
local function hookShieldReduction(char)
	local hum = char:WaitForChild("Humanoid")
	local lastHealth = hum.Health
	hum.HealthChanged:Connect(function(newHealth)
		if shieldActive and newHealth < lastHealth then
			local blocked = (lastHealth - newHealth) * ABILITY_CFG.Shield.DamageReduction
			hum.Health = math.min(hum.MaxHealth, newHealth + blocked)
		end
		lastHealth = hum.Health
	end)
end

if character then
	hookShieldReduction(character)
end
player.CharacterAdded:Connect(hookShieldReduction)

